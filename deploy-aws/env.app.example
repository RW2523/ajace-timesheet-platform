# =============================================================================
# App + S3 + URL overrides — APPENDED to the base Supabase .env by scripts/setup.sh.
# (Because this block is appended AFTER the base vars, anything redefined here
#  overrides the base default.)
#
# BEFORE this block, in the base section of .env, you MUST also change:
#   POSTGRES_PASSWORD   -> a strong password           (openssl rand -base64 24)
#   JWT_SECRET          -> 40+ random chars             (openssl rand -base64 40)
#   ANON_KEY            -> a JWT signed with JWT_SECRET  (see README §4)
#   SERVICE_ROLE_KEY    -> a JWT signed with JWT_SECRET  (see README §4)
#   DASHBOARD_PASSWORD  -> anything (Studio is off, but the var must be set)
# =============================================================================

# ---- Public URLs (point auth/rest/storage at your api. subdomain) -----------
API_EXTERNAL_URL=https://api.ajace.com
SUPABASE_PUBLIC_URL=https://api.ajace.com
SITE_URL=https://timesheet.ajace.com
ADDITIONAL_REDIRECT_URLS=https://timesheet.ajace.com

# ---- Auth hardening ---------------------------------------------------------
DISABLE_SIGNUP=false                 # employees self-register (app sets app=ajace_timesheets)
ENABLE_EMAIL_AUTOCONFIRM=true        # no SMTP needed; the ts_autoconfirm trigger also covers this
# For password reset emails later, configure SMTP_* in the base section.

# ---- Storage backend = S3 (files land in your bucket) -----------------------
STORAGE_S3_BUCKET=ajace-ts-files
STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ENDPOINT=                # leave blank for real AWS S3
# Credentials come from the EC2 instance IAM role (recommended — set nothing).
# Only if you cannot use a role, uncomment and fill:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- The Next.js app --------------------------------------------------------
# These two MUST equal the base ANON_KEY / your api URL above (anon key is public).
NEXT_PUBLIC_SUPABASE_URL=https://api.ajace.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_SAME_VALUE_AS_ANON_KEY
# Service role (server-side admin ops in the app) — equals base SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=PASTE_SAME_VALUE_AS_SERVICE_ROLE_KEY

# ---- Direct++ AI (OpenRouter) ----------------------------------------------
# The ONLY thing that leaves AWS. Used by lib/directpp to read documents.
OPENROUTER_API_KEY=sk-or-REPLACE
# Optional: pin the vision/LLM model Direct++ uses (else the app's default).
# DIRECTPP_MODEL=openai/gpt-4o-mini
