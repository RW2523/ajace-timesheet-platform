# =============================================================================
# Timesheet WEB APP (Next.js) — production environment
# Set these in the Vercel project (Settings → Environment Variables), NOT in git.
# Vercel project "Root Directory" MUST be set to:  app
# =============================================================================

# ---- Supabase (shared project: coaszrosqlhifcwxurwu) ------------------------
# The anon/publishable key is safe in the browser (protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://coaszrosqlhifcwxurwu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_nO8n5IxHIdrZSYf6WN5Ixw_vlRcUOOl

# ---- Python AI engine ------------------------------------------------------
# URL of the deployed FastAPI engine (Render/Fly/Railway — see engine/ configs).
# Leave BLANK to use the pure-serverless "Direct++" path (no engine, but no OCR /
# LibreOffice fidelity). On Vercel with no ENGINE_URL the app auto-selects Direct++.
ENGINE_URL=https://ajace-timesheet-engine.onrender.com

# Shared secret sent to the engine as the X-API-Key header.
# MUST equal the engine's TSE_API_KEY.  Generate: openssl rand -hex 32
ENGINE_API_KEY=

# ---- OpenRouter (only used by the serverless Direct++ path) -----------------
# Required ONLY when ENGINE_URL is blank / DIRECT_SERVERLESS=true.
# (TSE_OPENROUTER_API_KEY is also accepted as a fallback, matching the engine's key name.)
OPENROUTER_API_KEY=

# ---- Flow / feature switches -----------------------------------------------
# Force the serverless Direct++ path even when ENGINE_URL is set (optional):
# DIRECT_SERVERLESS=true
NEXT_PUBLIC_AI_ENABLED=1

# ---- Single-sign-on across *.ajace.com (optional; see deploy/sso-cookie-domain.md)
# COOKIE_DOMAIN=.ajace.com
