# =============================================================================
# Timesheet Intelligence ENGINE (Python/FastAPI) — production environment
# Set these as SECRETS in your host (Render env vars / `fly secrets set` /
# Railway variables / docker-compose .env). Never commit the filled-in file.
# =============================================================================

# ---- Auth: shared secret with the Next.js app -------------------------------
# The web app sends this as the X-API-Key header (its ENGINE_API_KEY).
# Generate: openssl rand -hex 32
TSE_API_KEY=

# ---- OpenRouter (all LLM/vision calls) -------------------------------------
# Optional: without a key the engine runs deterministic + local-OCR only and
# flags anything that would benefit from an LLM.
TSE_OPENROUTER_API_KEY=
TSE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TSE_OPENROUTER_APP_TITLE=Ajace Timesheet Intelligence
TSE_OPENROUTER_REFERER=https://timesheets.ajace.com

# ---- Behaviour --------------------------------------------------------------
TSE_LLM_POLICY=on_low_confidence      # never | on_low_confidence | always
TSE_LLM_CONFIDENCE_THRESHOLD=0.6
TSE_USE_LOCAL_OCR=true                # tesseract binary is bundled in the image
TSE_OCR_DPI=220

# ---- Calendar / policy ------------------------------------------------------
TSE_HOLIDAY_REGION=US
TSE_WEEKEND_DAYS=5,6
TSE_MAX_HOURS_PER_DAY=16

# ---- Paths (container-safe) -------------------------------------------------
TSE_OUTPUT_DIR=/tmp/ts_output
