# → app/.env.production  (NEXT_PUBLIC_* are baked at build; file must exist before `npm run build`)

# ---- Database: Amazon RDS PostgreSQL ----------------------------------------
DATABASE_URL=postgresql://tsadmin:CHANGE_ME@your-db.abc123.us-east-1.rds.amazonaws.com:5432/timesheet
# RDS uses TLS by default; leave PGSSL unset. Set PGSSL=disable only for a local no-TLS Postgres.
# PGSSL=disable
PG_POOL_MAX=5

# ---- Auth (self-managed): sign the session JWT ------------------------------
AUTH_JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
# NEXT_PUBLIC_COOKIE_DOMAIN=.ajace.com   # only if serving multiple subdomains
# Serving over the raw EC2 URL (plain HTTP, no domain/TLS)? set this to false,
# or the login cookie won't be sent back and sign-in silently fails.
# Flip to true once you're on HTTPS with a domain.
COOKIE_SECURE=false

# ---- S3 file storage --------------------------------------------------------
# MUST match the BucketName you passed to CloudFormation (S3 names are globally
# unique, so yours has a suffix — copy it from the stack's BucketName output).
STORAGE_S3_BUCKET=REPLACE_bucket_name_from_stack_output
# MUST be the region you deployed the stack in, or every upload fails.
STORAGE_S3_REGION=REPLACE_region_eg_us-east-2
# Credentials come from the EC2 instance IAM role — set nothing here.

# ---- Direct++ AI (OpenRouter — the only thing that leaves AWS) --------------
DIRECT_SERVERLESS=true
OPENROUTER_API_KEY=sk-or-REPLACE
NEXT_PUBLIC_AI_ENABLED=true

# ---- Password-reset email (Amazon SES) — OFF until you've set SES up --------
# Leave SES_FROM_EMAIL COMMENTED OUT until the sender is a verified SES identity
# AND the account is out of the SES sandbox. Enabling it early makes every reset
# throw MessageRejected, so nothing is delivered and nothing is logged.
# SES_FROM_EMAIL=noreply@ajace.com
# SES_REGION=us-east-2        # defaults to STORAGE_S3_REGION if unset
#
# Before SES is live, set this to 1 to write reset links to the pm2 log so you
# can still recover an account. Off by default: a live token in a log is a
# credential — turn it back off once SES works.
# AUTH_LOG_RESET_LINKS=1

# ---- App --------------------------------------------------------------------
NODE_ENV=production
# Raw EC2 URL for now (no domain): use  http://<EC2-public-IP>
# Switch to https://timesheet.<domain> once you add a domain + TLS.
SITE_URL=http://REPLACE_EC2_PUBLIC_IP     # used to build password-reset links
