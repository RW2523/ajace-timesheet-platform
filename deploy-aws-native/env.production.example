# → app/.env.production  (NEXT_PUBLIC_* are baked at build; file must exist before `npm run build`)

# ---- Database: Amazon RDS PostgreSQL ----------------------------------------
DATABASE_URL=postgresql://tsadmin:CHANGE_ME@your-db.abc123.us-east-1.rds.amazonaws.com:5432/timesheet
# RDS uses TLS by default; leave PGSSL unset. Set PGSSL=disable only for a local no-TLS Postgres.
# PGSSL=disable
PG_POOL_MAX=5

# ---- Auth (self-managed): sign the session JWT ------------------------------
AUTH_JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
# NEXT_PUBLIC_COOKIE_DOMAIN=.ajace.com   # only if serving multiple subdomains

# ---- S3 file storage --------------------------------------------------------
STORAGE_S3_BUCKET=ajace-ts-files
STORAGE_S3_REGION=us-east-1
# Credentials come from the EC2 instance IAM role — set nothing here.

# ---- Direct++ AI (OpenRouter — the only thing that leaves AWS) --------------
DIRECT_SERVERLESS=true
OPENROUTER_API_KEY=sk-or-REPLACE
NEXT_PUBLIC_AI_ENABLED=1

# ---- Password-reset email (Amazon SES) --------------------------------------
# Sender MUST be a verified SES identity (email or domain). Leave unset to skip
# email and log the reset link instead (dev). IAM role needs ses:SendEmail.
SES_FROM_EMAIL=noreply@ajace.com
# SES_REGION=us-east-1        # defaults to STORAGE_S3_REGION if unset

# ---- App --------------------------------------------------------------------
NODE_ENV=production
SITE_URL=https://timesheet.ajace.com     # used to build password-reset links
