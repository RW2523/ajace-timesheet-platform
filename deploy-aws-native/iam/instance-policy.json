{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TimesheetS3Objects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::ajace-ts-files/*"
    },
    {
      "Sid": "TimesheetS3List",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::ajace-ts-files"
    },
    {
      "Sid": "TimesheetSESSend",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendRawEmail"],
      "Resource": "*"
    }
  ]
}
